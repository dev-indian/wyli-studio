# WYLI Studio — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# EmailJS
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=your_customer_template_id
VITE_EMAILJS_OWNER_TEMPLATE_ID=your_owner_template_id

# Google Apps Script (for Google Sheets persistence)
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# Analytics
VITE_GA_MEASUREMENT_ID=G-L3EJYL1CG0
